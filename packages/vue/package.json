{
  "name": "@byrding/vue",
  "version": "0.5.0",
  "description": "Vue 3 adapter for @byrding/core — defineStore returns a composable via shallowReactive",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "!src/**/__tests__"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "state-management",
    "react",
    "vue",
    "store",
    "reactive",
    "typescript",
    "cross-framework"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nurmaso/byrding",
    "directory": "packages/vue"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@byrding/core": "workspace:^"
  },
  "peerDependencies": {
    "vue": ">=3.0.0"
  },
  "devDependencies": {
    "@vue/test-utils": "^2.4.0",
    "jsdom": "^25.0.0",
    "typescript": "^5.0.2",
    "vitest": "^2.0.0",
    "vue": "^3.4.0"
  }
}
