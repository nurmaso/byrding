{
  "name": "@byrding/plugin-persist",
  "version": "0.1.0",
  "description": "Persistence plugin for @byrding — syncs store state to localStorage/sessionStorage",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nurmaso/byrding",
    "directory": "packages/plugin-persist"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "@byrding/core": ">=0.10.0"
  },
  "devDependencies": {
    "@byrding/core": "workspace:*",
    "typescript": "^5.0.2",
    "vitest": "^2.0.0"
  }
}
