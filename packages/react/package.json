{
  "name": "@byrding/react",
  "version": "0.5.0",
  "description": "React adapter for @byrding/core — defineStore returns a hook via useSyncExternalStore",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      },
      "require": {
        "types": "./dist/testing.d.cts",
        "default": "./dist/testing.cjs"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "!src/**/__tests__"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "state-management",
    "react",
    "vue",
    "store",
    "reactive",
    "typescript",
    "cross-framework"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nurmaso/byrding",
    "directory": "packages/react"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@byrding/core": "workspace:^"
  },
  "peerDependencies": {
    "@testing-library/react": ">=14.0.0",
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "@testing-library/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.0",
    "@types/react": "^18.0.28",
    "@types/react-dom": "^18.0.0",
    "jsdom": "^25.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "typescript": "^5.0.2",
    "vitest": "^2.0.0"
  }
}
