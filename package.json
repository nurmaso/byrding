{
  "name": "byrding-monorepo",
  "private": true,
  "version": "0.0.3",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "test": "pnpm -r --filter \"./packages/*\" test",
    "dev:playground": "pnpm --filter @byrding/playground dev",
    "dev:render-demo": "pnpm --filter @byrding/render-demo dev",
    "docs:dev": "pnpm --filter @byrding/docs dev",
    "docs:build": "pnpm --filter @byrding/docs build",
    "docs:preview": "pnpm --filter @byrding/docs preview"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "typescript": "^5.0.2",
    "vitest": "^2.0.0"
  },
  "packageManager": "pnpm@9.0.0"
}
